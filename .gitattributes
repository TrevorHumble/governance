# Shell hooks and scripts MUST stay LF, or autocrlf (on here) corrupts the
# shebang/line-endings and one of them silently fails to run.
.githooks/** text eol=lf
*.sh text eol=lf
vendor/skills/** -text
# Impeccable is copied byte for byte from upstream; git must not touch its line endings.
.claude/skills/impeccable/** -text
